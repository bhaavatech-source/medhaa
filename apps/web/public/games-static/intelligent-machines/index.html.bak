<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>From Humans to Intelligent Machines | Bhava Tech</title>
<meta name="description" content="Discover how humans recreated their own abilities through engineering">
<link rel="stylesheet" href="css/variables.css">
<link rel="stylesheet" href="css/base.css">
<link rel="stylesheet" href="css/layout.css">
<link rel="stylesheet" href="css/components.css">
<link rel="stylesheet" href="css/animations.css">
<link rel="stylesheet" href="css/responsive.css">
</head>
<body>

<canvas id="particle-canvas"></canvas>

<div id="loader-screen" class="loader-screen">
  <div class="loader-core">
    <div class="loader-ring"></div>
    <div class="loader-ring ring2"></div>
    <div class="loader-ring ring3"></div>
    <p class="loader-text">Booting Engineering Lab<span class="dots">...</span></p>
  </div>
</div>

<header id="app-header" class="app-header glass">
  <div class="brand">
    <span class="brand-logo">&#9881;&#65039;</span>
    <div class="brand-text">
      <h1>From Humans to Intelligent Machines</h1>
      <p>Discover How Humans Recreated Their Own Abilities Through Engineering</p>
    </div>
  </div>
  <nav id="level-nav" class="level-nav">
    <button class="nav-btn active" data-level="1"><span class="nav-num">1</span>Humans &amp; Machines</button>
    <button class="nav-btn" data-level="2"><span class="nav-num">2</span>Human vs Machine</button>
    <button class="nav-btn" data-level="3"><span class="nav-num">3</span>Engineering Map</button>
    <button class="nav-btn" data-level="4"><span class="nav-num">4</span>Curiosity Explorer</button>
  </nav>
  <button
  id="sound-toggle"
  class="sound-toggle"
  aria-label="Toggle Sound"
  title="Toggle sound"
>
  &#128266;
</button>

<button
  id="menu-toggle"
  class="menu-toggle"
  aria-label="Toggle Menu"
>
  &#9776;
</button>
</header>

<main id="app-main">
  <div id="explorer-progress" class="explorer-progress"></div>
  <section id="level-1" class="level-section active-level">
    <div id="level1-root" class="level-container"></div>
  </section>

  <section id="level-2" class="level-section">
    <div id="level2-root" class="level-container"></div>
  </section>

  <section id="level-3" class="level-section">
    <div id="level3-root" class="level-container"></div>
  </section>

  <section id="level-4" class="level-section">
    <div id="level4-root" class="level-container"></div>
  </section>

</main>

<footer class="app-footer glass">
  <p>Bhava Tech &mdash; Engineering Curiosity Lab &middot; Built with HTML5, CSS3 &amp; Vanilla JS</p>
</footer>

<div id="modal-overlay" class="modal-overlay">
  <div id="modal-content" class="modal-content glass"></div>
</div>

<script src="js/data/abilities.js"></script>
<script src="js/data/engineeringDomains.js"></script>
<script src="js/data/curiosityMap.js"></script>
<script src="js/data/quizData.js"></script>

<script src="js/utils.js"></script>
<script src="js/sound.js"></script>
<script src="js/effects.js"></script>
<script src="js/particles.js"></script>
<script src="js/svgIcons.js"></script>

<script src="js/level1.js"></script>
<script src="js/level2.js"></script>
<script src="js/level3.js"></script>
<script src="js/level4.js"></script>

<script src="js/minigames.js"></script>
<script src="js/quiz.js"></script>
<script src="js/data/badgeData.js"></script>

<script src="js/router.js"></script>
<script src="js/main.js"></script>
</body>
</html>
