  {id:"ic", year:"1958", name:"Integrated Circuit", inventor:"Jack Kilby & Robert Noyce", importance:"Placed many transistors on a single piece of silicon instead of wiring them separately.", impact:"Started the path toward packing billions of components into a fingernail-sized chip.", icon:"🔲"},
  {id:"microprocessor", year:"1971", name:"Microprocessor", inventor:"Intel team — Ted Hoff, Federico Faggin, Stan Mazor", importance:"An entire CPU brain squeezed onto one chip (Intel 4004).", impact:"Made personal computers, calculators, and embedded devices possible.", icon:"🧠"},
  {id:"pc", year:"1970s-80s", name:"Personal Computer", inventor:"Apple, IBM, Microsoft era", importance:"Microprocessors became affordable enough for homes, schools, and offices.", impact:"Computing moved from labs and militaries into everyday human life.", icon:"🖥️"},
  {id:"internet", year:"1990s", name:"Internet", inventor:"ARPANET → Tim Berners-Lee (WWW)", importance:"Chips inside routers and servers let computers talk to each other globally.", impact:"Connected billions of chips worldwide into one giant thinking network.", icon:"🌐"},
  {id:"smartphone", year:"2007", name:"Smartphone", inventor:"Apple iPhone team & industry", importance:"Combined dozens of chip types (CPU, GPU, modem, sensors) into your pocket.", impact:"Put more computing power in a hand than entire 1980s data centers had.", icon:"📱"},
  {id:"ai_chip", year:"2010s-2020s", name:"AI Chips", inventor:"NVIDIA, Google (TPU), many labs", importance:"Chips designed specifically to do millions of tiny math operations for learning, not just logic.", impact:"Powers voice assistants, self-driving cars, and generative AI.", icon:"🤖"},
