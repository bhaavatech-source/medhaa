
const HistoryData = [
  {id:"abacus", year:"~2000 BCE", name:"Abacus", inventor:"Ancient Chinese & Babylonian traders", importance:"First tool humans built to calculate faster than the mind alone.", impact:"Enabled trade, taxation, and record keeping across early civilizations.", icon:"🧮"},
