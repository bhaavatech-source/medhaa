
:root{
  --bg:#0a0e1a; --bg2:#0f1626; --panel:rgba(255,255,255,0.05);
  --border:rgba(255,255,255,0.1); --accent:#00e0ff; --accent2:#a855f7;
  --accent3:#ffb703; --text:#e8eefc; --text-dim:#9aa5c4; --green:#22c55e; --red:#ef4444;
  --radius:18px;
}
*{box-sizing:border-box; margin:0; padding:0;}
body{
  background:radial-gradient(circle at 20% 10%, #14203a 0%, var(--bg) 60%);
  color:var(--text); font-family:'Segoe UI',system-ui,sans-serif; min-height:100vh; overflow-x:hidden;
}
#app{display:flex; flex-direction:column; min-height:100vh;}
#top-nav{
  display:flex; align-items:center; gap:16px; padding:14px 22px;
  background:rgba(10,14,26,0.85); backdrop-filter:blur(14px);
  border-bottom:1px solid var(--border); position:sticky; top:0; z-index:50;
}
.brand{font-size:1.15rem; font-weight:700; display:flex; align-items:center; gap:8px;
  background:linear-gradient(90deg,var(--accent),var(--accent2)); -webkit-background-clip:text; background-clip:text; color:transparent;}
.progress-wrap{flex:1; height:8px; background:var(--panel); border-radius:99px; overflow:hidden; border:1px solid var(--border);}
#progress-bar{height:100%; width:0%; background:linear-gradient(90deg,var(--accent),var(--accent2)); transition:width .5s ease;}
.nav-actions{display:flex; gap:10px; align-items:center;}
#search-input{background:var(--panel); border:1px solid var(--border); color:var(--text); padding:8px 14px; border-radius:12px; font-size:.85rem; width:180px;}
#badges-btn{background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:8px 12px; cursor:pointer; font-size:1rem;}
#badges-btn:hover{background:rgba(255,255,255,0.12); transform:scale(1.05);}

#section-nav{display:flex; gap:8px; padding:12px 22px; overflow-x:auto; background:var(--bg2); border-bottom:1px solid var(--border);}
.nav-btn{
  background:var(--panel); border:1px solid var(--border); color:var(--text-dim);
  padding:9px 16px; border-radius:99px; font-size:.85rem; white-space:nowrap; cursor:pointer; transition:.25s;
}
.nav-btn:hover{color:var(--text); border-color:var(--accent);}
.nav-btn.active{background:linear-gradient(90deg,var(--accent),var(--accent2)); color:#04101f; font-weight:600; border-color:transparent;}

#stage{flex:1; padding:32px 22px 80px; max-width:1200px; margin:0 auto; width:100%;}

.section-title{font-size:1.8rem; margin-bottom:6px; background:linear-gradient(90deg,var(--accent),var(--accent2)); -webkit-background-clip:text; background-clip:text; color:transparent;}
.section-sub{color:var(--text-dim); margin-bottom:28px; font-size:.95rem;}

.card{
  background:var(--panel); border:1px solid var(--border); border-radius:var(--radius);
  padding:20px; backdrop-filter:blur(10px); transition:.25s; cursor:pointer; position:relative; overflow:hidden;
}
.card:hover{transform:translateY(-4px); border-color:var(--accent); box-shadow:0 10px 30px rgba(0,224,255,0.15);}

.grid{display:grid; gap:18px;}
.grid-4{grid-template-columns:repeat(auto-fill,minmax(200px,1fr));}
.grid-3{grid-template-columns:repeat(auto-fill,minmax(260px,1fr));}

/* Welcome */
.welcome-hero{text-align:center; padding:40px 0;}
.chip-grow{font-size:5rem; display:inline-block; animation:pulseGrow 3s ease-in-out infinite;}
@keyframes pulseGrow{0%,100%{transform:scale(1);} 50%{transform:scale(1.15);}}
.evolve-row{display:flex; justify-content:center; align-items:center; gap:10px; flex-wrap:wrap; margin-top:26px; font-size:2rem;}
.evolve-row span.arrow{color:var(--accent); font-size:1.3rem;}
.evolve-item{opacity:0; animation:fadeUp .6s forwards;}
@keyframes fadeUp{from{opacity:0; transform:translateY(14px);} to{opacity:1; transform:translateY(0);}}
.hero-msg{margin-top:26px; font-size:1.3rem; font-weight:600; color:var(--accent3);}
.start-btn{
  margin-top:30px; background:linear-gradient(90deg,var(--accent),var(--accent2)); color:#04101f; border:none;
  padding:14px 34px; font-size:1rem; font-weight:700; border-radius:99px; cursor:pointer; transition:.25s;
  box-shadow:0 8px 25px rgba(168,85,247,0.35);
}
.start-btn:hover{transform:scale(1.06);}

/* Timeline */
.timeline{position:relative; padding-left:26px; border-left:3px solid var(--border); margin-top:20px;}
.tl-item{position:relative; margin-bottom:26px; padding-left:16px; cursor:pointer;}
.tl-item::before{content:''; position:absolute; left:-31px; top:4px; width:14px; height:14px; border-radius:50%; background:var(--accent); box-shadow:0 0 12px var(--accent);}
.tl-item .tl-year{color:var(--accent3); font-weight:700; font-size:.8rem;}
.tl-item .tl-name{font-size:1.2rem; font-weight:700; display:flex; align-items:center; gap:8px;}
.tl-detail{display:none; margin-top:10px; padding:14px; background:var(--panel); border-radius:12px; border:1px solid var(--border); font-size:.88rem; line-height:1.5;}
.tl-item.open .tl-detail{display:block; animation:fadeUp .4s;}

/* zoom */
.zoom-stage{display:flex; flex-direction:column; align-items:center; gap:14px; margin:20px 0;}
.zoom-level{font-size:3rem; opacity:.3; transition:.4s;}
.zoom-level.active{opacity:1; transform:scale(1.3); text-shadow:0 0 20px var(--accent);}
.zoom-controls{display:flex; gap:12px; margin-top:14px;}
.zoom-controls button{background:var(--panel); border:1px solid var(--border); color:var(--text); padding:8px 18px; border-radius:12px; cursor:pointer;}
.zoom-controls button:hover{border-color:var(--accent);}
.zoom-label{color:var(--text-dim); font-size:.85rem; min-height:20px;}

/* Chip family */
.chip-card .icon{font-size:2.2rem;}
.chip-card .cat{font-size:.7rem; text-transform:uppercase; color:var(--accent); letter-spacing:.05em;}
.chip-card h4{margin:6px 0;}
.diff-dots span{opacity:.25;}
.diff-dots span.filled{opacity:1; color:var(--accent3);}

/* Modal */
#chip-modal{position:fixed; inset:0; background:rgba(0,0,0,0.65); display:flex; align-items:center; justify-content:center; z-index:200; backdrop-filter:blur(4px);}
#chip-modal.hidden{display:none;}
.modal-card{
  background:var(--bg2); border:1px solid var(--border); border-radius:20px; max-width:640px; width:92%;
  max-height:85vh; overflow-y:auto; padding:28px; position:relative; box-shadow:0 20px 60px rgba(0,0,0,.6);
  animation:fadeUp .3s;
}
#close-modal{position:absolute; top:14px; right:14px; background:var(--panel); border:1px solid var(--border); color:var(--text); border-radius:10px; padding:6px 12px; cursor:pointer;}
.modal-content h2{margin-bottom:4px;}
.modal-content .sub{color:var(--accent); font-size:.85rem; margin-bottom:14px;}
.modal-block{margin:14px 0;}
.modal-block h4{color:var(--accent3); font-size:.85rem; text-transform:uppercase; margin-bottom:6px;}
.tag-list{display:flex; flex-wrap:wrap; gap:8px;}
.tag{background:var(--panel); border:1px solid var(--border); padding:4px 12px; border-radius:99px; font-size:.78rem; cursor:pointer;}
.tag:hover{border-color:var(--accent); color:var(--accent);}

/* devices */
.device-card{text-align:center;}
.device-card .icon{font-size:2.6rem;}
.device-detail{margin-top:16px;}
.device-chip-grid{display:flex; flex-wrap:wrap; gap:10px; margin-top:12px; justify-content:center;}
.mini-chip{background:var(--panel); border:1px solid var(--border); border-radius:12px; padding:10px 14px; cursor:pointer; text-align:center; transition:.2s;}
.mini-chip:hover{border-color:var(--accent); transform:translateY(-3px);}

/* flow */
.flow-row{display:flex; align-items:center; justify-content:center; gap:10px; flex-wrap:wrap; margin:30px 0;}
.flow-node{background:var(--panel); border:1px solid var(--border); border-radius:14px; padding:16px 20px; text-align:center; min-width:100px;}
.flow-node.active{border-color:var(--accent); box-shadow:0 0 20px rgba(0,224,255,.4); transform:scale(1.08);}
.flow-arrow{font-size:1.4rem; color:var(--accent);}
.pulse-dot{width:14px; height:14px; border-radius:50%; background:var(--accent3); position:relative; box-shadow:0 0 10px var(--accent3);}

/* factory */
.factory-steps{display:flex; flex-direction:column; gap:12px; margin-top:20px;}
.factory-step{display:flex; align-items:center; gap:16px; padding:14px 18px; border-radius:14px; background:var(--panel); border:1px solid var(--border); cursor:pointer;}
.factory-step.done{border-color:var(--green); background:rgba(34,197,94,.08);}
.factory-step .num{width:34px; height:34px; border-radius:50%; background:var(--accent); color:#04101f; display:flex; align-items:center; justify-content:center; font-weight:700; flex-shrink:0;}
.factory-detail{display:none; font-size:.85rem; color:var(--text-dim); margin-top:6px;}
.factory-step.open .factory-detail{display:block;}

/* quiz */
.quiz-box{max-width:600px; margin:0 auto;}
.quiz-q{font-size:1.15rem; margin-bottom:20px; font-weight:600;}
.quiz-opt{display:block; width:100%; text-align:left; background:var(--panel); border:1px solid var(--border); color:var(--text); padding:14px 18px; border-radius:12px; margin-bottom:10px; cursor:pointer; transition:.2s;}
.quiz-opt:hover{border-color:var(--accent);}
.quiz-opt.correct{border-color:var(--green); background:rgba(34,197,94,.15);}
.quiz-opt.wrong{border-color:var(--red); background:rgba(239,68,68,.15);}
.quiz-explain{margin-top:16px; padding:14px; background:var(--panel); border-radius:12px; border:1px solid var(--border); font-size:.88rem; display:none;}
.quiz-nav{margin-top:20px; text-align:right;}
.quiz-nav button{background:linear-gradient(90deg,var(--accent),var(--accent2)); border:none; color:#04101f; font-weight:700; padding:10px 24px; border-radius:99px; cursor:pointer;}
.quiz-score{text-align:center; font-size:1.4rem; margin-top:20px;}

/* toast */
#toast{position:fixed; bottom:24px; right:24px; background:var(--bg2); border:1px solid var(--accent); border-radius:14px; padding:14px 22px; z-index:300; transform:translateY(120%); transition:.4s; box-shadow:0 10px 30px rgba(0,0,0,.5);}
#toast.show{transform:translateY(0);}

/* badges panel */
#badges-panel{position:fixed; top:70px; right:20px; width:280px; background:var(--bg2); border:1px solid var(--border); border-radius:16px; padding:18px; z-index:150; box-shadow:0 20px 40px rgba(0,0,0,.5);}
#badges-panel.hidden{display:none;}
#badges-panel h3{display:flex; justify-content:space-between; margin-bottom:12px; font-size:1rem;}
#badges-panel h3 button{background:none; border:none; color:var(--text-dim); cursor:pointer; font-size:1rem;}
.badge-item{display:flex; align-items:center; gap:10px; padding:8px 0; border-bottom:1px solid var(--border); font-size:.82rem;}
.badge-item.locked{opacity:.35;}

/* future chips */
.future-card{border-left:3px solid var(--accent2);}
.future-tag{display:inline-block; background:rgba(168,85,247,.2); color:var(--accent2); font-size:.7rem; padding:3px 10px; border-radius:99px; margin-bottom:8px;}

@media(max-width:640px){
  #top-nav{flex-wrap:wrap;}
  #search-input{width:120px;}
  .grid-4{grid-template-columns:repeat(2,1fr);}
}
