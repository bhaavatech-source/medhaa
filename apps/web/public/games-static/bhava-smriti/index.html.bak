<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bhāva-samṛti</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="wrap">
    <div class="glass main-card">
      <header>
        <div class="brand">
          <div class="logo">🧠</div>
          <div>
            <h1>Bhāva-samṛti</h1>
            <p>Flip. Match. Remember. Explore 20 worlds.</p>
          </div>
        </div>
        <div class="status">
          <div class="pill" id="hudWorld">World: Animal Safari</div>
          <div class="pill" id="hudMoves">Moves: 0</div>
          <div class="pill" id="hudTime">Time: 0s</div>
          <div class="pill" id="hudScore">Score: 0</div>
        </div>
      </header>

      <div class="topbar">
        <select class="select" id="worldSelect" aria-label="Choose world"></select>
        <button class="btn ghost" id="soundBtn">🔊 Sound</button>
        <button class="btn primary" id="startBtn">Start Journey</button>
      </div>

      <section class="hero" id="heroBox">
        <h2>Choose a world and begin the memory journey.</h2>
        <p>One reusable engine, many worlds. Everything stays in one place.</p>
      </section>

      <section class="worlds" id="worldGrid"></section>

      <section class="boardwrap hidden" id="gameArea">
        <div class="boardhead">
          <div class="status">
            <button class="btn ghost" id="backBtn">← Back</button>
            <button class="btn ghost" id="shuffleBtn">Shuffle</button>
            <button class="btn ghost" id="easyBtn">Easy</button>
            <button class="btn ghost" id="mediumBtn">Medium</button>
            <button class="btn ghost" id="hardBtn">Hard</button>
          </div>
          <div class="pill" id="goalPill">Match all pairs</div>
        </div>
        <div class="board" id="board"></div>
      </section>
    </div>
  </div>

  <div class="overlay" id="winOverlay">
    <div class="glass panel">
      <h3>Great job! 🎉</h3>
      <p id="winText">You matched every card.</p>
      <div class="win-actions">
        <button class="btn primary" id="nextWorldBtn">Next World →</button>
        <button class="btn ghost" id="playAgainBtn">Play Again</button>
      </div>
    </div>
  </div>

  <script src="game.js"></script>

  </script>
  <!-- End Bhava Game Menu -->


  <!-- Bhava Tech Session Tracker -->
  <script>document.title = "Memory Match";</script>
  <script src="bhava-bridge.js"></script>
<script src="bhava-session.js"></script>
<script src="bhava-game-nav.js"></script>
<script src="bhava-tech-all.js"></script>
  <script src="bhava-responsive.js"></script>
</body>
</html>
</body>
</html>