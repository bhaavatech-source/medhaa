{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@medhaa/*": ["../../packages/*/src"],
      "@medhaa/ui/*": ["../../packages/ui/src"]
    }
  },
  "include": ["src", "src/components/GamesDiscovery.tsx"]
}