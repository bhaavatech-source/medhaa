## Copy this file to "keystore.properties" (same folder) and fill in your
## real values. That file is gitignored and must never be committed.
## Note: storeFile is resolved relative to the app/ module dir (Gradle's
## file() call lives in app/build.gradle), so it needs FOUR "../" to reach
## the repo root's keystore/ folder — or just use an absolute path.
storeFile=../../../../keystore/medhaa-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=YOUR_KEY_ALIAS
keyPassword=YOUR_KEY_PASSWORD
