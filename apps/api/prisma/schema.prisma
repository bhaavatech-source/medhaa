// apps/api/prisma/schema.prisma
// Core relational schema for MEDHAA. Extend via new game/domain tables
// without altering these core entities.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

enum Role {
  STUDENT
  PARENT
  TEACHER
  ADMIN
}

enum SubscriptionPlan {
  FREE
  PLUS
  PREMIUM
  FAMILY
  SCHOOL
  INSTITUTION
  LIFETIME
  MONTHLY_1
  MONTHLY_2
  YEARLY_1
  YEARLY_2
}


enum SubscriptionStatus {
  PENDING
  TRIALING
  ACTIVE
  EXPIRED
  CANCELLED
}

model School {
  id        String   @id @default(uuid())
  name      String
  address   String?
  createdAt DateTime @default(now())
  students  Student[]
  teachers  Teacher[]
  admins    Admin[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  googleId     String?  @unique
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLoginAt  DateTime?

  student  Student?
  parent   Parent?
  teacher  Teacher?
  admin    Admin?
  subscription Subscription?
  auditLogs AuditLog[]
  cognitiveCheckIns CognitiveCheckIn[]
  passwordResetTokens PasswordResetToken[]
}

model Student {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id])
  schoolId  String?
  school    School? @relation(fields: [schoolId], references: [id])
  parentId  String?
  parent    Parent? @relation(fields: [parentId], references: [id])
  fullName  String
  gradeLevel Int?
  gradeLabel String?
  age       Int?
  coins     Int     @default(0)
  xp        Int     @default(0)
  level     Int     @default(1)
  streakDays Int    @default(0)

  attempts     GameAttempt[]
  achievements StudentAchievement[]
  coinLedger   CoinTransaction[]
}

model Parent {
  id       String    @id @default(uuid())
  userId   String    @unique
  user     User      @relation(fields: [userId], references: [id])
  fullName String
  children Student[]
}

model Teacher {
  id       String  @id @default(uuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id])
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  fullName String
}

model Admin {
  id       String  @id @default(uuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id])
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id])
  fullName String
}

model Game {
  id          String   @id @default(uuid())
  slug        String   @unique 
  title       String
  domain      String
  isFreeTier  Boolean
  entryPath   String
  ageLabel    String?
  skills      String[]
  kind        String   @default("game")
  tier        String?
  isActive    Boolean  @default(true)
  attempts    GameAttempt[]
}

model GameAttempt {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  gameId         String
  game           Game     @relation(fields: [gameId], references: [id])
  startTime      DateTime
  endTime        DateTime?
  durationMs     Int?
  score          Float?
  accuracy       Float?
  hintsUsed      Int      @default(0)
  completionStatus String @default("in_progress")
  createdAt      DateTime @default(now())
}

model Achievement {
  id          String @id @default(uuid())
  code        String @unique
  title       String
  description String
  iconUrl     String
  students    StudentAchievement[]
}

model StudentAchievement {
  id            String      @id @default(uuid())
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id])
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  unlockedAt    DateTime    @default(now())
}

model CoinTransaction {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  amount    Int      // positive = earn, negative = spend
  reason    String   // e.g. "daily_login", "game_completion", "coupon_redeem"
  createdAt DateTime @default(now())
}

model Subscription {
  id               String             @id @default(uuid())
  userId           String             @unique
  user             User               @relation(fields: [userId], references: [id])
  plan             SubscriptionPlan   @default(FREE)
  status           SubscriptionStatus @default(TRIALING)
  trialEndsAt      DateTime?
  currentPeriodEnd DateTime?
  amount           Int?
  paymentMethod    String?
  transactionRef   String?
  createdAt        DateTime           @default(now())
  notes String?
}

model CognitiveCheckIn {
  id          String   @id @default(uuid())
  studentId   String
  student     User     @relation(fields: [studentId], references: [id])
  completedAt DateTime @default(now())
}

model Coupon {
  id           String    @id @default(uuid())
  code         String    @unique
  type         String    // school | festival | referral | teacher | event | birthday
  rewardType   String    // coins | premium_days | discount_percent | game_pack
  rewardValue  String    // stored as string, parsed based on rewardType
  maxRedemptions Int?
  redeemedCount  Int      @default(0)
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
}


model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ParentConsent {
  id            String   @id @default(uuid())
  parentId      String
  policyVersion String
  consentedAt   DateTime @default(now())
  ipAddress     String?

  @@index([parentId])
}

// Standalone public submissions from medhaa-cognitive-assessment.html — this
// tool collects its own participant details and does not require a Medhā
// login, so results aren't tied to a User/Student row.
model CognitiveAssessmentResult {
  id                String   @id @default(uuid())
  appVersion        String?
  status            String
  participantName   String
  participantAge    Int?
  participantEmail  String?
  participantSchool String?
  purpose           String?
  parentName        String?
  relationship      String?
  consentRecord     Json?
  domainScores      Json?
  rawModuleData     Json?
  overallScore      Int?
  resultLevel       String?
  paymentReference  Json?
  integrityEvents   Json?
  ipAddress         String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
}
